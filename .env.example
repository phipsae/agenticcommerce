PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Use true for local dev/tests without real x402 settlement.
# Set false in production to enable @x402/express middleware.
X402_MOCK=true

# Base mainnet.
X402_NETWORK=eip155:8453
X402_PRICE=$0.01
X402_PAY_TO=0x0000000000000000000000000000000000000000
# PayAI supports Base mainnet (eip155:8453) without API keys.
# Coinbase CDP (https://api.cdp.coinbase.com/platform/v2/x402) requires CDP API keys.
# x402.org/facilitator is testnet-only (eip155:84532).
X402_FACILITATOR_URL=https://facilitator.payai.network

AGENT_NAME=Banana Secret Agent
AGENT_DESCRIPTION=Returns the secret after x402 payment: the best bananas are from ecuador.
AGENT_IMAGE_URL=https://placehold.co/512x512/png?text=Banana+Agent

# ERC-8004 draft registry addresses on Base mainnet.
# Fill these before registering. Known deployments can change while the ERC is draft.
ERC8004_CHAIN_ID=8453
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=
ERC8004_VALIDATION_REGISTRY=

# Base Sepolia registries for the /validation playground (the Validation
# Registry has no mainnet deployment). Defaults are the canonical testnet
# deployment; the identity registry is the one the Validation Registry is
# linked to (getIdentityRegistry()), NOT the canonical 0x8004A818... one.
ERC8004_SEPOLIA_IDENTITY_REGISTRY=0x8004AA63c570c570eBF15376c0dB199918BFe9Fb
ERC8004_SEPOLIA_VALIDATION_REGISTRY=0x8004C269D0A5647E51E121FeB226200ECE932d55

# Registration uses PRIVATE_KEY only when you run scripts/register-erc8004.ts.
# Never commit a real private key.
PRIVATE_KEY=
RPC_URL=

# Optional validator address for validation request script.
VALIDATOR_ADDRESS=
